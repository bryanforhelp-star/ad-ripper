# -------------------------------------------------------
# AdVault Local — environment configuration
# Copy this file to .env and fill in your values.
# -------------------------------------------------------

# Required: your Meta (Facebook) API access token
# Get one at https://developers.facebook.com/
META_ACCESS_TOKEN=your_token_here

# Meta Ads API version (default: v21.0)
META_ADS_API_VERSION=v21.0

# SQLite DB path (default: ./app.db)
DATABASE_URL=sqlite:///./app.db

# Whisper model to use: tiny | base | small | medium | large
# Smaller = faster; larger = more accurate
WHISPER_MODEL=base

# Path to ffmpeg binary (default assumes it is on PATH)
FFMPEG_PATH=ffmpeg

# Download timeout in seconds
DOWNLOAD_TIMEOUT_SECONDS=60

# Max retry attempts for downloads
DOWNLOAD_MAX_RETRIES=3

# Directory where ad media and transcripts are stored
DATA_DIR=./data
